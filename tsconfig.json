{
  "extends": "@tsconfig/node16/tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "outDir": ".homeybuild/",
    "rootDir": "."
  },
  "include": [
    "app.ts",
    "api.ts",
    "drivers/**/*.ts",
    "modbus/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".homeybuild",
    "modbus-test"
  ]
}
